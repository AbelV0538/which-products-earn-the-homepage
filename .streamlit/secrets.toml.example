# Example secrets. Copy this file to .streamlit/secrets.toml (git-ignored) and fill in your own
# values. Never commit the real file. Everything here is optional: without a key the app still
# runs and shows the rule-based verdict instead of the AI one.

# OpenRouter API key for the AI verdict (create one at https://openrouter.ai/keys).
# The app looks for a key pasted in the sidebar first, then this value, then the
# OPENROUTER_API_KEY environment variable.
OPENROUTER_API_KEY = "sk-or-v1-..."

[gcp]
# Google Cloud project billed for the BigQuery pipeline scripts (scripts/bq_auth.py,
# profile_bigquery.py, export_bigquery.py). The app itself never queries BigQuery.
# The --project flag and the GA4APP_GCP_PROJECT environment variable take precedence.
project_id = "your-gcp-project-id"
